{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "g1.studio.telemetry.v1",
  "title": "G1 Studio replay session v1",
  "type": "object",
  "required": ["schema_version", "metadata", "joint_names", "frames"],
  "properties": {
    "schema_version": {"const": 1},
    "metadata": {
      "type": "object",
      "required": ["mode", "backend_id", "model_variant", "clock_domain", "frame_id", "quaternion_convention", "provenance"],
      "properties": {
        "mode": {"const": "replay"},
        "quaternion_convention": {"const": "wxyz"},
        "hardware_validated": {"const": false},
        "command_path_enabled": {"const": false}
      }
    },
    "joint_names": {"type": "array", "minItems": 29, "maxItems": 29, "uniqueItems": true, "items": {"type": "string"}},
    "frames": {
      "type": "array", "minItems": 1, "maxItems": 3000,
      "items": {
        "type": "object",
        "required": ["time", "sequence", "source_time", "source_clock_domain", "receipt_time", "classification", "validity", "frame_id", "position", "quaternion_wxyz", "joints", "reference", "command", "health"],
        "properties": {
          "time": {"type": "number", "minimum": 0},
          "sequence": {"type": ["integer", "null"], "minimum": 0},
          "source_time": {"type": ["number", "null"]},
          "receipt_time": {"type": ["number", "null"]},
          "classification": {"enum": ["measured", "estimated", "commanded", "simulator-ground-truth", "unavailable"]},
          "position": {"type": ["array", "null"], "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
          "quaternion_wxyz": {"type": ["array", "null"], "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
          "joints": {"type": ["array", "null"], "minItems": 29, "maxItems": 29, "items": {"type": "number"}},
          "reference": {"type": ["object", "null"]},
          "command": {"type": ["object", "null"]},
          "health": {"type": "object"}
        }
      }
    }
  }
}
